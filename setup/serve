#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
[ -f "$FORMSUBSTRATE_ROOT/frontend/dist/index.html" ] || ( cd "$FORMSUBSTRATE_ROOT/frontend" && npm run build )
sf_venv
cd "$FORMSUBSTRATE_ROOT/backend"
export FORMSUBSTRATE_DIST="$FORMSUBSTRATE_ROOT/frontend/dist"
sf_say "serving http://127.0.0.1:${FORMSUBSTRATE_PORT:-5655}"
exec uvicorn app.main:app --host 127.0.0.1 --port "${FORMSUBSTRATE_PORT:-5655}"
