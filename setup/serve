#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
[ -f "$SUBFORM_ROOT/frontend/dist/index.html" ] || ( cd "$SUBFORM_ROOT/frontend" && npm run build )
sf_venv
cd "$SUBFORM_ROOT/backend"
export SUBFORM_DIST="$SUBFORM_ROOT/frontend/dist"
sf_say "serving http://127.0.0.1:${SUBFORM_PORT:-5655}"
exec uvicorn app.main:app --host "${SUBFORM_HOST:-127.0.0.1}" --port "${SUBFORM_PORT:-5655}"
