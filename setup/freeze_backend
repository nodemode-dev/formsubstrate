#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
if [ -n "${FORMSUBSTRATE_BUILD_VENV:-}" ]; then
  source "$FORMSUBSTRATE_BUILD_VENV/bin/activate"
else
  sf_venv
fi
python -c "import PyInstaller" 2>/dev/null || sf_die "PyInstaller missing: pip install -r backend/requirements_build.txt in the engine venv (build_app does this)"
dist="${FORMSUBSTRATE_FRONTEND_DIST:-$FORMSUBSTRATE_ROOT/frontend/dist}"
[ -f "$dist/index.html" ] || sf_die "the built window is missing at $dist: run ./build_app, or cd frontend && npx vite build"
work="${FORMSUBSTRATE_FREEZE_WORK:-$FORMSUBSTRATE_ROOT/backend}"
out="${FORMSUBSTRATE_ENGINE_OUT:-$FORMSUBSTRATE_ROOT/src-tauri/engine}"
sep=":"
[ "$(sf_os)" = windows ] && sep=";"
ext=""
[ "$(sf_os)" = windows ] && ext=".exe"
extra=()
[ -z "${FORMSUBSTRATE_PYI_ARCH:-}" ] || extra+=(--target-arch "$FORMSUBSTRATE_PYI_ARCH")
if [ "$(sf_os)" = macos ] && [ -n "${APPLE_SIGNING_IDENTITY:-}" ]; then
  extra+=(--codesign-identity "$APPLE_SIGNING_IDENTITY" --osx-entitlements-file "$FORMSUBSTRATE_ROOT/src-tauri/entitlements.plist")
fi
safe_rm() {
  local expected="$1" path="${2%/}"
  [ -n "$path" ] && [ "$path" != "/" ] && [ "$path" != "${HOME%/}" ] || sf_die "refusing to remove '$2'"
  [ "$(basename "$path")" = "$expected" ] || sf_die "refusing to remove $path: the folder must be named $expected"
  rm -rf "$path"
}
flatten_engine() {
  local dir="$1" fw="$1/_internal/Python.framework" lib="$1/_internal/Python" link f
  if [ -d "$fw" ]; then
    [ -f "$fw/Python" ] || sf_die "Python.framework has no Python library: $fw"
    rm -f "$lib"
    cp "$fw/Python" "$lib"
    rm -rf "$fw"
    install_name_tool -add_rpath @loader_path "$lib" 2>/dev/null || true
    codesign --force --sign - "$lib"
  fi
  while IFS= read -r link; do
    cp -RL "$link" "$link.flat" && rm -f "$link" && mv "$link.flat" "$link"
  done < <(find "$dir" -type l)
  [ -z "$(find "$dir" -type l | head -1)" ] || sf_die "engine still holds symbolic links after flattening: $dir"
  f="$(find "$dir" -name '*.framework' | head -1)"
  [ -z "$f" ] || sf_die "engine holds a .framework that cannot ship as Tauri resources: $f"
  while IFS= read -r f; do
    [ "$f" = "$lib" ] && continue
    if file -b "$f" | grep -q 'Mach-O' && otool -L "$f" | grep -q 'Python.framework'; then sf_die "$f links Python.framework, which the engine no longer ships"; fi
  done < <(find "$dir" -type f)
}
sign_engine() {
  local ent="$FORMSUBSTRATE_ROOT/src-tauri/entitlements.plist" f info signed=0 kept=0
  local files=()
  while IFS= read -r f; do
    if file -b "$f" | grep -Eq 'Mach-O.*(executable|shared library|bundle)'; then files+=("$f"); fi
  done < <(find "$1" -type f | awk -F/ '{print NF "\t" $0}' | sort -rn | cut -f2-)
  [ "${#files[@]}" -gt 0 ] || sf_die "no Mach-O file found to sign in $1"
  for f in "${files[@]}"; do
    info="$(codesign -d --verbose=4 "$f" 2>&1 || true)"
    if printf '%s\n' "$info" | grep -q '^Timestamp=' \
      && printf '%s\n' "$info" | grep -Eq '^CodeDirectory .*flags=[^ ]*runtime' \
      && ! printf '%s\n' "$info" | grep -q '^Signature=adhoc' \
      && codesign -d --entitlements - "$f" 2>/dev/null | grep -q 'com.apple.security.cs.disable-library-validation'; then
      kept=$((kept + 1))
      continue
    fi
    codesign --force --timestamp --options runtime --entitlements "$ent" --sign "$APPLE_SIGNING_IDENTITY" "$f"
    signed=$((signed + 1))
  done
  for f in "${files[@]}"; do codesign --verify --strict "$f" || sf_die "engine file failed its signature check: $f"; done
  sf_say "engine signed: ${#files[@]} Mach-O files, $signed signed here, $kept already signed by PyInstaller"
}
mkdir -p "$work"
safe_rm pyinstaller "$work/build/pyinstaller"
safe_rm dist-engine "$work/dist-engine"
cd "$FORMSUBSTRATE_ROOT/backend"
pyinstaller --noconfirm --clean --onedir --name formsubstrate-engine \
  --distpath "$work/dist-engine" --workpath "$work/build/pyinstaller" --specpath "$work/build/pyinstaller" \
  --add-data "$dist${sep}frontend_dist" \
  --add-data "$FORMSUBSTRATE_ROOT/backend/app/templates${sep}app/templates" \
  --add-data "$FORMSUBSTRATE_ROOT/backend/presets/graphs${sep}presets/graphs" \
  --add-data "$FORMSUBSTRATE_ROOT/backend/presets/plugins${sep}presets/plugins" \
  --add-data "$FORMSUBSTRATE_ROOT/backend/presets/skills${sep}presets/skills" \
  --add-data "$FORMSUBSTRATE_ROOT/backend/app/services/recipes/presets${sep}app/services/recipes/presets" \
  --add-data "$FORMSUBSTRATE_ROOT/backend/app/services/library/bundled${sep}app/services/library/bundled" \
  --add-data "$FORMSUBSTRATE_ROOT/backend/skills${sep}skills" \
  --collect-submodules app --collect-submodules uvicorn --collect-submodules keyring \
  --copy-metadata keyring \
  --hidden-import formsubstrate_ptyhost --hidden-import formsubstrate_mcp --hidden-import ptyprocess \
  --hidden-import app.services.gate_hook \
  --exclude-module tkinter \
  ${extra[@]+"${extra[@]}"} \
  "$FORMSUBSTRATE_ROOT/backend/formsubstrate_engine.py"
safe_rm engine "$out"
mkdir -p "$(dirname "$out")"
cp -R "$work/dist-engine/formsubstrate-engine" "$out"
if [ "$(sf_os)" = macos ]; then
  flatten_engine "$out"
  [ -z "${APPLE_SIGNING_IDENTITY:-}" ] || sign_engine "$out"
fi
"$out/formsubstrate-engine$ext" --selfcheck || sf_die "the frozen engine failed its self-check; see the line above"
sf_say "engine folder ready: $out ($(du -sh "$out" | awk '{print $1}'))"
