{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "{{name}}",
  "version": "0.1.0",
  "identifier": "ai.nodemode.{{name}}",
  "build": {
    "frontendDist": "../frontend",
    "devUrl": "http://localhost:{{port_frontend}}"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "{{name}}", "width": 1100, "height": 720 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "copyright": "Copyright (C) 2026 NodeAgentc, Inc.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
