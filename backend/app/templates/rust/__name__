#!/usr/bin/env bash
set -e
cd "$(dirname "$0")"

bin=target/release/{{name}}-cli
if [ ! -x "$bin" ] || [ -n "$(find cli core Cargo.toml -newer "$bin" \( -name '*.rs' -o -name '*.toml' \) 2>/dev/null | head -1)" ]; then
  command -v cargo >/dev/null || { echo "Rust is required: https://rustup.rs" >&2; exit 1; }
  cargo build -q --release -p {{name}}-cli >&2
fi
exec "$bin" "$@"
