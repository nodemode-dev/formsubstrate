#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
source setup/lib.sh

usage() {
  cat <<'EOF'
./build_app            build the Substrate desktop app from this folder, start to finish
  --no-install         macOS: leave the built app where it is instead of copying it to Applications
  --install            Linux: install the built .deb with apt (asks for your password)
  --open               open the app when the build is done
  --clean              rebuild the Rust side and the frozen engine from nothing
Every step's output goes to build_app.log beside this file.
Optional: APPLE_SIGNING_IDENTITY signs the app and the frozen engine (see docs/RELEASE.md);
FORMSUBSTRATE_BUNDLES picks the Linux bundle types (default deb);
CARGO_TARGET_DIR moves the Rust build folder.
EOF
}

install_app=auto open_app=0 clean=0
for arg in "$@"; do
  case "$arg" in
    --no-install) install_app=no ;;
    --install) install_app=yes ;;
    --open) open_app=1 ;;
    --clean) clean=1 ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done

safe_rm() {
  local expected="$1" path="${2%/}"
  [ -n "$path" ] && [ "$path" != "/" ] && [ "$path" != "${HOME%/}" ] || sf_die "refusing to remove '$2'"
  [ "$(basename "$path")" = "$expected" ] || sf_die "refusing to remove $path: the folder must be named $expected"
  rm -rf "$path"
}

log="$FORMSUBSTRATE_ROOT/build_app.log"
: > "$log"
exec > >(tee -a "$log") 2>&1
trap 'status=$?; [ $status -eq 0 ] || printf "\n[formsubstrate] the build stopped (exit %s). The full log is %s\n" "$status" "$log"' EXIT

os="$(sf_os)"
step() { printf '\n[formsubstrate] == %s\n' "$*"; }

step "checking the tools"
[ "$os" = macos ] || [ "$os" = linux ] || sf_die "build_app runs on macOS and Linux; on Windows run build_app.bat"
if [ "$os" = macos ]; then
  xcode-select -p >/dev/null 2>&1 || sf_die "the Xcode command line tools are missing: run xcode-select --install, then ./build_app again"
fi
py="$(sf_python)" || sf_die "Python 3.13 or newer is required (on macOS: brew install python)"
command -v node >/dev/null 2>&1 || sf_die "Node 20.19 or newer is required (on macOS: brew install node)"
node -e 'const [a,b]=process.versions.node.split(".").map(Number); process.exit(a>22||(a===22&&b>=12)||(a===20&&b>=19)?0:1)' \
  || sf_die "Node $(node -v) is too old; Vite needs 20.19 or 22.12 or newer"
[ -f "$HOME/.cargo/env" ] && source "$HOME/.cargo/env"
command -v cargo >/dev/null 2>&1 || sf_die "Rust is missing: install it from https://rustup.rs, then run ./build_app again"
if [ "$os" = linux ] && ! pkg-config --exists webkit2gtk-4.1 2>/dev/null; then
  sf_die "Tauri needs system libraries; on Debian or Ubuntu: sudo apt install libwebkit2gtk-4.1-dev build-essential curl wget file libxdo-dev libssl-dev librsvg2-dev patchelf"
fi
version="$("$py" -c 'import json, sys; print(json.load(open(sys.argv[1]))["version"])' src-tauri/tauri.conf.json)"
sf_say "building Substrate $version from $(pwd)"
sf_say "python $("$py" -c 'import platform; print(platform.python_version())'), node $(node -v), $(rustc -V)"

step "installing the engine and the window packages if missing"
[ -f backend/venv/bin/activate ] || ( cd backend && ./oc_install )
[ -d frontend/node_modules ] || ( cd frontend && bash ./oc_install )
if [ -n "${FORMSUBSTRATE_BUILD_VENV:-}" ]; then pip_bin="$FORMSUBSTRATE_BUILD_VENV/bin/pip"; else pip_bin="backend/venv/bin/pip"; fi
"$pip_bin" install -q -r backend/requirements_build.txt

dist="${FORMSUBSTRATE_FRONTEND_DIST:-$FORMSUBSTRATE_ROOT/frontend/dist}"
engine_out="${FORMSUBSTRATE_ENGINE_OUT:-$FORMSUBSTRATE_ROOT/src-tauri/engine}"
export FORMSUBSTRATE_FRONTEND_DIST="$dist" FORMSUBSTRATE_ENGINE_OUT="$engine_out"

if [ "$clean" = 1 ]; then
  step "cleaning earlier builds"
  ( cd src-tauri && cargo clean )
  safe_rm pyinstaller "${FORMSUBSTRATE_FREEZE_WORK:-backend}/build/pyinstaller"
  safe_rm dist-engine "${FORMSUBSTRATE_FREEZE_WORK:-backend}/dist-engine"
  safe_rm engine "$engine_out"
fi

step "building the window"
( cd frontend && npx vite build --outDir "$dist" --emptyOutDir )
step "freezing the engine"
setup/freeze_backend

adhoc=0
if [ "$os" = macos ] && [ -z "${APPLE_SIGNING_IDENTITY:-}" ]; then adhoc=1; fi
tauri_config="$("$py" -c 'import json, sys
dist, engine, adhoc = sys.argv[1], sys.argv[2], sys.argv[3] == "1"
bundle = {"resources": {engine: "engine"}}
if adhoc:
    bundle["macOS"] = {"signingIdentity": "-"}
print(json.dumps({"build": {"frontendDist": dist}, "bundle": bundle}))' "$dist" "$engine_out" "$adhoc")"
tauri_args=(build --config "$tauri_config")
case "$os" in
  macos) tauri_args+=(--bundles app) ;;
  linux) tauri_args+=(--bundles "${FORMSUBSTRATE_BUNDLES:-deb}") ;;
esac

step "building the desktop app (the first build compiles several hundred Rust crates)"
frontend/node_modules/.bin/tauri "${tauri_args[@]}"

target="${CARGO_TARGET_DIR:-$FORMSUBSTRATE_ROOT/src-tauri/target}"
bundle="$target/release/bundle"

if [ "$os" = macos ]; then
  app="$bundle/macos/Substrate.app"
  [ -d "$app" ] || sf_die "the build finished but $app is missing"
  codesign --verify --deep --strict "$app" 2>/dev/null || sf_say "codesign could not verify the app; it is ad-hoc signed, so macOS may ask once before it opens"
  step "packing the disk image"
  mkdir -p "$bundle/dmg"
  arch="$(uname -m)"
  [ "$arch" = x86_64 ] && arch=x64
  dmg="$bundle/dmg/formsubstrate-${version}-macos-${arch}.dmg"
  stage="$(mktemp -d)"
  ditto "$app" "$stage/Substrate.app"
  ln -s /Applications "$stage/Applications"
  rm -f "$dmg"
  hdiutil create -quiet -volname Substrate -srcfolder "$stage" -ov -format UDZO "$dmg"
  rm -rf "$stage"
  sf_say "app: $app"
  sf_say "disk image: $dmg"
  target_app=""
  if [ "$install_app" != no ]; then
    dest=/Applications
    [ -w "$dest" ] || { dest="$HOME/Applications"; mkdir -p "$dest"; }
    rm -rf "$dest/Substrate.app"
    ditto "$app" "$dest/Substrate.app"
    xattr -dr com.apple.quarantine "$dest/Substrate.app" 2>/dev/null || true
    target_app="$dest/Substrate.app"
    sf_say "installed: $target_app"
  fi
  if [ "$open_app" = 1 ]; then open "${target_app:-$app}"; fi
else
  deb="$(ls -t "$bundle"/deb/*.deb 2>/dev/null | head -1 || true)"
  [ -n "$deb" ] && sf_say "package: $deb"
  ls "$bundle"/*/ 2>/dev/null | sed 's/^/  /'
  if [ "$install_app" = yes ] && [ -n "$deb" ]; then
    sudo apt install -y "$deb"
  elif [ -n "$deb" ]; then
    sf_say "install it with: sudo apt install $deb   (or run ./build_app --install)"
  fi
  if [ "$open_app" = 1 ]; then
    "$target/release/formsubstrate" >/dev/null 2>&1 &
  fi
fi
sf_say "done in ${SECONDS}s"
