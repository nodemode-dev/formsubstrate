{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The page is served by the engine on 127.0.0.1, a remote origin to Tauri, so the capability lists that address for the main window and every app command has an allow permission generated by build.rs.",
  "windows": ["main"],
  "remote": { "urls": ["http://127.0.0.1:*"] },
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "shell:allow-open",
    "notification:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-start-dragging",
    "core:window:allow-set-decorations",
    "allow-set-window-title",
    "allow-app-ready",
    "allow-text-edit",
    "allow-window-token"
  ]
}
